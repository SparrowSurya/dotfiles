{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .UserName }}@{{ .HostName }}",
  "palette": {
    "base": "#1e1e2e",
    "mantle": "#181825",
    "surface0": "#313244",
    "text": "#cdd6f4",
    "subtext0": "#a6adc8",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "sapphire": "#74c7ec",
    "green": "#a6e3a1",
    "mauve": "#cba6f7",
    "pink": "#f5c2e7",
    "yellow": "#f9e2af",
    "red": "#f38ba8"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "template": "{{ if gt .Code 0 }}\uf00d {{ else }}\uf00c {{ end }}"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "",
          "background": "p:surface0",
          "foreground": "p:sapphire",
          "template": "{{ .Icon }} ",
          "properties": {
            "macos": "\ue711",
            "linux": "\ue712",
            "windows": "\ue70f",
            "cache_duration": "none"
          }
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "p:surface0",
          "foreground": "p:lavender",
          "template": "{{ .UserName }} ",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "p:blue",
          "foreground": "p:base",
          "template": " \uf07c {{ .Path }} ",
          "properties": {
            "style": "folder",
            "home_icon": "~",
            "folder_separator_icon": "/",
            "cache_duration": "none"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "p:mauve",
          "foreground": "p:base",
          "template": " \ue725 {{ .HEAD }} ",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "cache_duration": "none"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "background": "p:yellow",
          "foreground": "p:base",
          "template": " \uf017 {{ .CurrentDate | date .Format }}",
          "properties": {
            "time_format": "3:04 PM",
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "p:surface0",
          "foreground": "p:subtext0",
          "template": "\udb81\uded7 {{ .FormattedMs }}",
          "properties": {
            "style": "austin",
            "threshold": 500,
            "cache_duration": "none"
          }
        },
        {
          "type": "battery",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "p:surface0",
          "foreground": "p:text",
          "template": "{{ if not .Error }}{{ .Icon }} {{ .Percentage }}%{{ end }}",
          "properties": {
            "charged_icon": "\udb80\udc79 ",
            "charging_icon": "\udb80\udc84 ",
            "discharging_icon": "\udb80\udc7e ",
            "cache_duration": "none"
          },
          "foreground_templates": [
            "{{ if eq \"Charging\" .State.String }}p:green{{ end }}",
            "{{ if eq \"Discharging\" .State.String }}p:pink{{ end }}",
            "{{ if eq \"Full\" .State.String }}p:sapphire{{ end }}"
          ]
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "p:surface0",
          "foreground": "p:lavender",
          "template": "\uf4bc CPU: {{ round .PhysicalPercentUsed .Precision }}%",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "exit",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }}\u2716{{ else }}\u2714{{ end }} \u276f",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          }
        }
      ]
    }
  ]
}
